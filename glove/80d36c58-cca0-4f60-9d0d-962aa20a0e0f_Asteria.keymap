/////////////////////////////////////////////////////////////////////////////
// Home row mods
/////////////////////////////////////////////////////////////////////////////
// hold-trigger-on-release is mainline behavior in ZMK v0.3 -- no patch needed.
#define MAKE_HRM(name, trigger_keys) \
    behaviors { \
        name: name { \
            compatible = "zmk,behavior-hold-tap"; \
            #binding-cells = <2>; \
            flavor = "balanced"; \
            tapping-term-ms = <TAPPING_TERM_MS>; \
            quick-tap-ms = <QUICK_TAP_MS>; \
            require-prior-idle-ms = <REQUIRE_PRIOR_IDLE_MS>; \
            bindings = <&kp>, <&kp>; \
            hold-trigger-key-positions = <trigger_keys>; \
            hold-trigger-on-release; \
        }; \
    };

MAKE_HRM(hml, KEYS_R THUMBS)
MAKE_HRM(hmr, KEYS_L THUMBS)

/////////////////////////////////////////////////////////////////////////////
// Layer-tap replacement
/////////////////////////////////////////////////////////////////////////////
// ZMK's built-in &lt default flavor is "tap-preferred", which buffers any
// interrupting key until the tapping-term timer expires -- i.e. it is
// "timerful" and defeats the point of the balanced home row mods above.
// "balanced" instead resolves the hold as soon as an interrupting key is
// both pressed AND released within the tapping term, so a real hold engages
// the layer immediately and a real tap lets the interrupting key through
// immediately. quick-tap-ms additionally lets a double-tap-and-hold
// auto-repeat the tap keycode instead of re-triggering the layer hold.
//
// This is a new named behavior (&tlt) that REPLACES `&lt` in your keymap's
// bindings, rather than a label-override of `&lt` itself: label-overrides
// (`&lt { ... };`) are impossible in the Glove80 injection context (they are
// only valid at the devicetree top level, not inside the root node), and a
// named behavior also avoids globally mutating `&lt` for anything else that
// might rely on its stock tap-preferred behavior.
behaviors {
    tlt: tlt {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;
        quick-tap-ms = <QUICK_TAP_MS>;
        bindings = <&mo>, <&kp>;
    };
};

/////////////////////////////////////////////////////////////////////////////
// Smart shift (simplified urob magic-shift, thumb key)
/////////////////////////////////////////////////////////////////////////////
// tap         -> sticky shift: capitalizes only the next key pressed
// shift + tap -> caps-word: capitalizes until the next word break
// hold        -> regular (momentary) shift
//
// Deliberately NO require-prior-idle-ms here: unlike the home row mods above,
// this key is meant to be pressed mid-typing-flow (e.g. mid-word, to
// capitalize the next letter), so it must not be gated behind an idle period.
behaviors {
    sticky_shift: sticky_shift {
        compatible = "zmk,behavior-sticky-key";
        #binding-cells = <1>;
        bindings = <&kp>;
        release-after-ms = <1000>;
        quick-release;
        ignore-modifiers;
    };

    smart_shift_tap: smart_shift_tap {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&sticky_shift LSHFT>, <&caps_word>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    smart_shift: smart_shift {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <200>;
        quick-tap-ms = <QUICK_TAP_MS>;
        bindings = <&kp>, <&smart_shift_tap>;
    };
};

// convenience alias: use SMART_SHIFT directly as a keymap binding
#define SMART_SHIFT &smart_shift LSHFT 0
